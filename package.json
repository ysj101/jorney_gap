{
  "name": "journeygap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tests/tsconfig.json",
    "lint": "biome check .",
    "test": "vitest run",
    "audit": "pnpm audit --audit-level high",
    "schema:check": "node scripts/schemas.mjs",
    "schema:generate": "node scripts/schemas.mjs --write",
    "validators:check": "node packages/core/scripts/validators.mjs",
    "validators:generate": "node packages/core/scripts/validators.mjs --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@opentelemetry/api": "1.9.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "24.10.1",
    "jsdom": "27.0.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
