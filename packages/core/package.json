{
  "name": "@journeygap/core",
  "version": "0.1.0",
  "description": "JourneyGap core",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "schema"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/journeygap.schema.json": "./schema/journeygap.schema.json",
    "./schema/relay.schema.json": "./schema/relay.schema.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "json-schema-to-ts": "3.1.1"
  }
}
