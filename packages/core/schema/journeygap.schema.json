{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://journeygap.dev/schema/journeygap.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "enabled",
    "serviceName",
    "otlpTracesEndpoint",
    "consent",
    "journeys"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "serviceName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "serviceVersion": {
      "type": "string",
      "maxLength": 64
    },
    "otlpTracesEndpoint": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https?://[^\\s?#@]+/v1/traces$"
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "ui"
      ],
      "properties": {
        "mode": {
          "const": "opt-in"
        },
        "ui": {
          "enum": [
            "compact",
            "external"
          ]
        }
      }
    },
    "routes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "pattern"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,63}$"
          },
          "pattern": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^/(?:[a-zA-Z0-9._~-]+|:[a-zA-Z][a-zA-Z0-9_]*|/)*$"
          }
        }
      }
    },
    "journeys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "steps",
          "timeoutMinutes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,63}$"
          },
          "steps": {
            "type": "array",
            "minItems": 2,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9._-]{0,63}$"
                },
                "terminal": {
                  "type": "boolean"
                }
              }
            }
          },
          "timeoutMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1440,
            "default": 30
          }
        }
      }
    },
    "attributesAllowlist": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^app\\.[a-z][a-z0-9._-]*$"
      }
    }
  }
}
