{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://journeygap.dev/schema/relay.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "allowedOrigins",
    "services",
    "retentionDays",
    "rateLimitPerMinute"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "allowedOrigins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 2048,
        "pattern": "^https?://[^\\s/?#@]+$"
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "serviceName",
          "journeys"
        ],
        "properties": {
          "serviceName": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,63}$"
          },
          "journeys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "steps",
                "timeoutMinutes"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9._-]{0,63}$"
                },
                "steps": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 20,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9._-]{0,63}$"
                      },
                      "terminal": {
                        "type": "boolean"
                      }
                    }
                  }
                },
                "timeoutMinutes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1440,
                  "default": 30
                }
              }
            }
          },
          "attributesAllowlist": {
            "type": "array",
            "maxItems": 10,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^app\\.[a-z][a-z0-9._-]*$"
            }
          }
        }
      }
    },
    "retentionDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365,
      "default": 14
    },
    "rateLimitPerMinute": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "maxDatabaseBytes": {
      "type": "integer",
      "minimum": 1048576,
      "maximum": 1099511627776
    },
    "maxEvents": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000
    }
  }
}
